# Copy to dev.env (gitignored; worktrees read the main checkout's) and fill in what you have. KEY=value lines, `~` and
# `$VAR` expand; a variable set in the environment wins. scripts/dev-env.sh loads it for the scripts and the harness.

# Game data for the Rust checks (docs/development.md "Set up")
RBR_DATA=
RBR_PATCH=
RBR_RECORDINGS=
RBR_VECTOR_STORE=
RBR_NGP_PHYSICS=
RBR_RSF=                 # a RallySimFans install (rsf_compare.py, rsf-session.sh)

# The harness's folder; the rest default inside it (scripts/dev-env.sh)
RBR_DEV=~/rerbr-dev
#RBR_GAME=$RBR_DEV/game             vanilla 1.02 install the harness runs under Wine
#RBR_PREFIX=$RBR_DEV/prefix         its Wine prefix
#RBR_NGP_GAME=$RBR_DEV/ngp-game     NGP 7.4.778 install
#RBR_NGP_PREFIX=$RBR_DEV/ngp-prefix
#RBR_RSF_PREFIX=$RBR_DEV/rsf-prefix the Wine prefix RBR_RSF's game runs in
#RBR_TOOLCHAIN=$RBR_DEV/toolchain   MSVC 7.1 for the harness plugin (msvc71/, wineprefix/)
#RBR_RUNS=$RBR_DEV/runs             recordings, playbacks, snapshots
#RBR_NGP_RUNS=$RBR_DEV/ngp-runs
#RBR_RSF_RUNS=$RBR_DEV/rsf-runs
#RBR_HARNESS_PLUGIN=$RBR_DEV/plugin/RBRRecompHarness.dll
#RBR_RSF_PLUGIN=$RBR_DEV/rsf-plugin
#RBR_APITRACE=$RBR_DEV/apitrace
#RBR_FFB_TRACE=$RBR_DEV/ffb-trace
RBR_PROTON=              # PROTONPATH umu-run starts the games with (empty: umu's default)
