# Wheel indices follow the CCar+0x470 pointer array. CWheel's scratch is inline
# at +0x800, so these are CWheel+0xc58/+0xc5c (surface ids) and +0xc54 (blend).
wheel0_x *0x8ef660 +0x470 +0x0 * +0xc58 u32
wheel0_y *0x8ef660 +0x470 +0x0 * +0xc5c u32
wheel0_z *0x8ef660 +0x470 +0x0 * +0xc54 f32
wheel1_x *0x8ef660 +0x470 +0x4 * +0xc58 u32
wheel1_y *0x8ef660 +0x470 +0x4 * +0xc5c u32
wheel1_z *0x8ef660 +0x470 +0x4 * +0xc54 f32
wheel2_x *0x8ef660 +0x470 +0x8 * +0xc58 u32
wheel2_y *0x8ef660 +0x470 +0x8 * +0xc5c u32
wheel2_z *0x8ef660 +0x470 +0x8 * +0xc54 f32
wheel3_x *0x8ef660 +0x470 +0xc * +0xc58 u32
wheel3_y *0x8ef660 +0x470 +0xc * +0xc5c u32
wheel3_z *0x8ef660 +0x470 +0xc * +0xc54 f32
