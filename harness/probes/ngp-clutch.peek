# Clutch help under NGP (notes/ngp.md). The VCU (CScratchSim) is inline at CCar+0x850: m_fixedClutch
# (payload clutch) +0x1c, m_launchMode +0x4c, m_state +4 (LaunchClutch output at +0x4c), m_drive +0x58
# (clutch input CDrive+0x60; its +8 object holds the engine speed Get4520 at +0x45c and the gear state +0x54c/+0x570).
launch_mode *0x8ef660 +0x89c i32
clutch_in *0x8ef660 +0x86c f32
clutch_help *0x8ef660 +0x854 * +0x4c f32
drive_clutch *0x8ef660 +0x8a8 * +0x60 f32
engine_w *0x8ef660 +0x8a8 * +0x8 * +0x45c f32
gear_54c *0x8ef660 +0x8a8 * +0x8 * +0x54c i32
gear_570 *0x8ef660 +0x8a8 * +0x8 * +0x570 i32
car_654 *0x8ef660 +0x654 f32
car_gear *0x8ef660 +0x1100 i32
